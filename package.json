{
  "name": "harak",
  "private": true,
  "version": "1.0.0",
  "description": "حَراك — تطبيق تدريبٍ شخصي عربي مبنيّ على أنماط الحركة (PWA).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@fontsource/changa": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "dexie": "^4.4.7",
